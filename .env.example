MYSQL_DATABASE=concurrency_lab
MYSQL_USER=lab
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=1
DB_POOL_RECYCLE=1800
REDIS_MAX_CONNECTIONS=10
IO_TIMEOUT=1
READINESS_TIMEOUT=2
